# Copy to .env for local runs. NEVER commit real values; in Azure these come from Key Vault references.
FILS_ENV=development                      # development | staging | production
FILS_DATABASE_URL=postgresql+psycopg://fils:fils@localhost:5432/fils
FILS_LOG_LEVEL=INFO

# Required in staging/production (>= 32 random bytes). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
FILS_JWT_SECRET=
# Required in staging/production: base64 of 32 random bytes. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FILS_DATA_KEY=

# Sign in with Apple: bundle id (and Services ID if web) ; Google: OAuth client ids (iOS, Android, server)
FILS_APPLE_CLIENT_IDS=["kw.fils.fils"]
FILS_GOOGLE_CLIENT_IDS=[]

# Cloud AI (optional). disabled | azure_openai
FILS_LLM_PROVIDER=disabled
FILS_AZURE_OPENAI_ENDPOINT=
FILS_AZURE_OPENAI_API_KEY=
FILS_AZURE_OPENAI_DEPLOYMENT=
FILS_ASSISTANT_MONTHLY_TOKEN_BUDGET=200000

# Speech (optional). disabled | azure
FILS_SPEECH_PROVIDER=disabled
FILS_AZURE_SPEECH_KEY=
FILS_AZURE_SPEECH_REGION=

# Statement image OCR (optional)
FILS_DOCUMENT_INTELLIGENCE_ENDPOINT=
FILS_DOCUMENT_INTELLIGENCE_KEY=

# Billing
FILS_APPLE_BUNDLE_ID=kw.fils.fils
FILS_APPLE_PRODUCT_IDS=["kw.fils.premium.monthly","kw.fils.premium.yearly"]
FILS_APPLE_ROOT_CA_PATHS=["fils_api/certs/AppleRootCA-G3.cer"]
FILS_GOOGLE_PACKAGE_NAME=kw.fils.fils
FILS_GOOGLE_PRODUCT_IDS=["kw.fils.premium"]
FILS_GOOGLE_SERVICE_ACCOUNT_JSON=
FILS_GOOGLE_PUBSUB_AUDIENCE=
FILS_GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# Limits
FILS_RATE_LIMIT_ENABLED=true
FILS_CORS_ORIGINS=[]
